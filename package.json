{
  "name": "@codecrafters/claude-code",
  "description": "Build your own Claude Code challenge, from CodeCrafters",
  "type": "module",
  "scripts": {
    "dev": "bun run app/main.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build app/main.ts --target bun --outfile dist/agent.js",
    "check": "bun run typecheck && bun test && bun run build",
    "coverage": "bun test --coverage",
    "eval": "bun run evals/harness.ts --live",
    "eval:mock": "bun run evals/harness.ts --mock"
  },
  "dependencies": {
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.3"
  }
}
